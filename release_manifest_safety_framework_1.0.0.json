                "generated_with": {
                    "commands": [
                        {
                            "command": "cov-build",
                            "configuration": [
                                "--emit-complementary-info",
                                "--dir <build intermediate output directory>",
                                "-c coverity_output/compiler_config.xml",
                                "<a shell script running xc8-cc once per .c file in src/>"
                            ]
                        },
                        {
                            "command": "cov-analyze",
                            "configuration": [
                                "--dir <build intermediate output directory>",
